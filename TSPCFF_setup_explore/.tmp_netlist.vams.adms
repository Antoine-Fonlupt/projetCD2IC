# 1 "tmp/tmp_netlist.vams"






# 1 "disciplines.vams"






















# 25 "disciplines.vams"



nature current
  access = I;
  units = "A";
  abstol = 0.001234;
endnature


nature voltage
  access = V;
  units = "V";
  abstol = 0.0004321;
endnature


nature power
  access = Pwr;
  units = "W";
  abstol = 0.00101010;
endnature


nature flux
  access = Phi;
  units = "We";
endnature


nature temperature
  access = Temp;
  units = "K";
  abstol = 3.14;
endnature


discipline thermal
  potential temperature;
  flow power;
enddiscipline


discipline electrical
  potential voltage;
  flow current;
enddiscipline

discipline magnetic
  potential voltage; 
  flow current; 
enddiscipline

discipline rotational_omega
  potential voltage; 
  flow current; 
enddiscipline



# 8 "tmp/tmp_netlist.vams"
module g45n1svt (d,g,s,b) ;
    inout d,g,s,b;
    electrical d,g,s,b ;
    parameter integer m=1 ;
    parameter real l=45e-9 ;
    parameter real w=260e-9 ;
endmodule

module g45p1svt (d,g,s,b) ;
    inout d,g,s,b;
    electrical d,g,s,b ;
    parameter integer m=1 ;
    parameter real l=45e-9 ;
    parameter real w=260e-9 ;
endmodule





# 1 "disciplines.vams"























# 84 "disciplines.vams"

# 29 "tmp/tmp_netlist.vams"

module INV ( VDD , VSS , A , Y );
  inout       VDD ,  VSS ,  A , Y ;
  parameter WN=145e-9 ;
  parameter WP=214e-9 ;
  
  electrical VDD ;
  electrical VSS ;
  electrical A ;
  electrical Y ;
  g45n1svt #( .l(4.5e-08), .w(WN))  mn0 ( .d(Y) , .g(A) , .s(VSS), .b(VSS));
  g45p1svt #( .l(4.5e-08), .w(WP))  mp0 ( .d(Y) , .g(A) , .s(VDD) , .b(VDD));
endmodule



module TSPCFF ( CK, D, QQ, VDD, VSS );
  inout       CK, D, QQ, VDD, VSS ;

  parameter l0 = 4.5e-08;
  parameter wn0 = 145e-9 ;
  parameter wp0 = 214e-9 ;

  electrical VDD ;
  electrical VSS ;
  electrical D ;
  electrical QQ ; 
  electrical Qb ;
  electrical CK ;
  electrical CKb ;
  electrical a ;
  electrical b ;
  electrical c ;
  electrical x ;
  electrical y ;

  
  INV #(.WN(145e-9), .WP(215e-9)) clkinv (.VDD(VDD) , .VSS(VSS) , .A(CK) , .Y(CKb) ) ; 
  
  
  INV #(.WN(260e-9), .WP(390e-9)) qinv (.VDD(VDD) , .VSS(VSS) , .A(Qb) , .Y(QQ) ) ;
  
  
  g45p1svt #( .l(l0), .w(wp0))  mp1 ( .d(x) , .g(D) , .s(VDD), .b(VDD));
  g45p1svt #( .l(l0), .w(wp0))  mp2 ( .d(b) , .g(CKb) , .s(VDD), .b(VDD));
  g45p1svt #( .l(l0), .w(wp0))  mp3 ( .d(c) , .g(y) , .s(VDD), .b(VDD));

  
  g45n1svt #( .l(l0), .w(wn0))  mn4 ( .d(x) , .g(CKb) , .s(a), .b(VSS));
  g45p1svt #( .l(l0), .w(wp0))  mp4 ( .d(y) , .g(x) , .s(b), .b(VDD));
  g45p1svt #( .l(l0), .w(wp0))  mp5 ( .d(Qb) , .g(CKb) , .s(c), .b(VDD));

  
  g45n1svt #( .l(l0), .w(wn0))  mn1 ( .d(a) , .g(D) , .s(VSS), .b(VSS));
  g45n1svt #( .l(l0), .w(wn0))  mn2 ( .d(y) , .g(CKb) , .s(VSS), .b(VSS));
  g45n1svt #( .l(l0), .w(wn0))  mn3 ( .d(Qb) , .g(y) , .s(VSS), .b(VSS));
  
endmodule
